# Postgres connection string
DATABASE_URL=postgres://stl:stl@localhost:5432/stl

# BetterAuth — generate a secret with: openssl rand -base64 32
# Also keys the signed /api/files access tokens and (by default) the encrypted
# Bambu/Onshape credentials, so it must be strong on any real deployment.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Set to true to turn off self-registration (the /sign-up page and the
# email/password sign-up API) once your accounts exist. OIDC single sign-on
# still creates users on first login — who may authenticate is the IdP's call.
# DISABLE_SIGNUP=true

# Key used to encrypt stored Bambu Cloud tokens (for MakerWorld .3mf downloads).
# Optional — falls back to BETTER_AUTH_SECRET when unset. Rotating it forces
# users to reconnect their Bambu account.
# BAMBU_TOKEN_SECRET=

# Optional "Sign in with Onshape" (enables the Onshape import/sync feature).
# Create an OAuth application at https://dev-portal.onshape.com/oauthApps with
# the redirect URL {BETTER_AUTH_URL}/api/onshape/callback and permission to
# read documents + profile information, then paste its credentials here.
# ONSHAPE_CLIENT_ID=
# ONSHAPE_CLIENT_SECRET=

# Optional OIDC single sign-on (shows an SSO button on the sign-in page when
# all three are set). Register the redirect URI with your provider:
#   {BETTER_AUTH_URL}/api/auth/oauth2/callback/oidc
# The issuer must serve /.well-known/openid-configuration.
# Authentik: use the per-application issuer, NOT the domain root:
#   OIDC_ISSUER=https://auth.example.com/application/o/<app-slug>/
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Button label, defaults to "SSO"
# OIDC_PROVIDER_NAME=Authentik

# Headless slicer service (the `slicer` service in compose.yml). Estimates
# print time & filament use for unsliced .3mf uploads. Optional — without it,
# unsliced files simply show no estimates.
SLICER_URL=http://localhost:8000

# Headless OpenSCAD service (the `openscad` service in compose.yml). Renders
# customized .3mf files from parametric .scad model files. Optional — without
# it, the customizer UI is hidden and .scad files are plain downloads.
OPENSCAD_URL=http://localhost:8001

# S3-compatible block storage (MinIO defaults from docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=models
S3_FORCE_PATH_STYLE=true
